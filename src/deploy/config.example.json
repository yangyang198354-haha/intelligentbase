{
  "_comment": [
    "intelligentbase 配置文件模板（**纯占位符，无任何真实值**）。",
    "用法：复制为 config.json 放到目标机 /etc/intelligentbase/config.json，由 systemd 单元经 IB_CONFIG_FILE 指向。",
    "注意：本文件**不含凭据**。所有密钥/令牌一律经 EnvironmentFile 注入环境变量（见 env.example）。",
    "合并优先级：内置默认值 < 本文件 < 环境变量（IB_ 前缀）。"
  ],

  "config_source": "file",
  "offline_mode": false,

  "ledger_backend": "sqlite",
  "ledger_path": "/var/lib/intelligentbase/ledger/ledger.sqlite3",

  "max_upload_mb": 50,
  "ocr_enabled": true,
  "render_enabled": true,

  "blob": {
    "enabled": true,
    "root": "/var/lib/intelligentbase/blobs"
  },

  "embedding": {
    "backend": "http",
    "url": "http://127.0.0.1:8100",
    "model_id": "bge-m3",
    "dim": 1024,
    "cold_timeout_s": 120.0,
    "cold_max_retries": 3,
    "cold_batch_size": 16,
    "hot_timeout_s": 3.0,
    "hot_max_retries": 1
  },

  "vectorstore": {
    "backend": "qdrant",
    "url": "http://127.0.0.1:6333",
    "grpc_port": 6334,
    "on_disk_vectors": true,
    "hnsw_m": 16,
    "hnsw_ef_construct": 128,
    "hnsw_ef_search": 64,
    "rest_fallback": true
  },

  "retrieval": {
    "top_k": 5,
    "score_threshold": 0.35,
    "candidate_multiplier": 4
  },

  "chunking": {
    "chunk_size": 800,
    "chunk_overlap": 120,
    "normalizer_version": "v1"
  },

  "llm": {
    "backend": "openai_compatible",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "api_key_env": "IB_LLM_API_KEY",
    "router_temperature": 0.0,
    "expert_temperature": 0.3,
    "aggregator_temperature": 0.3,
    "request_timeout_s": 60.0
  },

  "authz": {
    "policy": "injected",
    "require_injected_policy": true
  },

  "logging": {
    "level": "INFO",
    "json_lines": true
  },

  "worker": {
    "lease_seconds": 300,
    "batch_limit": 8,
    "poll_interval_s": 2.0,
    "max_retries": 3
  },

  "session": {
    "backend": "memory",
    "max_history_messages": 20,
    "sticky_turns": 1
  },

  "projects": {
    "demo": {
      "name": "示例项目（接入时替换）",
      "active_collection_version": "1",
      "embedding_model_id": "bge-m3",
      "dim": 1024,
      "kb_ids": ["kb_default"]
    }
  }
}
