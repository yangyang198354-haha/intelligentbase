# ---------------------------------------------------------------------------
# @module MOD-IB-25
# @implements IFC-IB-286 `ib-embed` 的服务端 EnvironmentFile 模板（**第二份 .env.example**）
# @author software-developer
#
# 与 `src/deploy/env.example`（`ib-web` 的 EnvironmentFile）**键集合分离**：
#   * `ib-web.env` 携带业务基座的键（含 **凭据**：IB_LLM_API_KEY / IB_SERVICE_TOKEN …）；
#   * `ib-embed.env` **只有 11 个 `IB_EMBED_*` 键**，且**不含任何凭据**。
# 分离的理由（R-3 架构残余建议）：两份文件的**信任级别不同**。`ib-embed` 只监听回环、
# 无鉴权、无令牌需求；把它与「装着 LLM API Key 的文件」合并，等于给一个不需要凭据的
# 服务多发一份凭据 —— 纯粹的凭据面净增。分开放，本文件的权限位即便放宽到 0644
# 也不泄露任何秘密（仍建议统一 0600，见下）。
#
# 安装（目标机，需 root）：
#   install -m 0600 -o ib-embed -g ib-embed ib-embed.env.example /etc/intelligentbase/ib-embed.env
#
# 本文件被 git 跟踪：**任何真实值都不得写入**（即便后续删除，`git log -p` 仍能取回）。
# 填值只在部署机的 0600 文件里做。
#
# 键名清单的权威落点：`docs/ib_embed_service_contract.md` §9（语义与默认值）；
# `docs/tech_stack.md` §1.2（登记视图）。二者与本文件**逐键对应**，不得新增/改名。
# `src/ib_embed/config.py::load_config()` 只读这 11 个键（键清单是该文件的封闭集合）。
#
# 附：启动期纪律（IFC-IB-263）——缺失必填项 → 非零码退出 + **只报键名、不回显值**。
# 唯一的必填键是 `IB_EMBED_MODEL_PATH`（无默认；离线加载必需）。
# ---------------------------------------------------------------------------

# === 监听（回环专用；本服务**无鉴权**，不得改绑 0.0.0.0）========================
IB_EMBED_HOST=127.0.0.1
# 须与 `ib-web.env` 的 `IB_EMBED_URL` 端口一致（默认 8100）。
IB_EMBED_PORT=8100

# === 模型 ====================================================================
# 须与 `ib-web.env` 的 `IB_EMBED_MODEL_ID` 一致（否则客户端一律 409 model_mismatch）。
IB_EMBED_MODEL_ID=bge-m3
# 启动期**交叉校验**用：与权重实测维度不符 → **启动失败（不回退）**（契约 §4.1）。
IB_EMBED_DIM=1024
# **必填、无默认**：本地权重目录（离线加载，不联网下载）。
IB_EMBED_MODEL_PATH=<REPLACE_ME_local_model_dir>

# === 批上限与截断 ============================================================
# 硬约束：本值**必须 ≥** 客户端 `cold_batch_size`（默认 16）。若运维调大了客户端批量
# 而此处未同步 → 冷路径必然 400 batch_too_large 且**不重试** → 整批文档入库失败。
# 服务端在 400 错误体里**回显 max_batch**，正是为了让该错配一眼可定位。
IB_EMBED_MAX_BATCH=64
# 单条 token 上限：超长**截断保前缀**并继续（不失败），在 truncated_indices 中标注。
IB_EMBED_MAX_TOKENS=8192

# === 并发与队列（**有界**；超限快速失败，绝不无界排队）========================
# CPU 单模型；[TBD-T16] 实测校准。
IB_EMBED_MAX_CONCURRENCY=1
# 队列深度上限；满即 503 overloaded 并回显 retry_after_s。
IB_EMBED_QUEUE_DEPTH=8
# 推理线程数：避免与 Qdrant / ib-web / OCR 抢核；[TBD-T16] 实测校准。
IB_EMBED_THREADS=2

# === 内存预算（**必须与单元文件 MemoryMax 数值一致**）========================
# 单元 `src/deploy/systemd/ib-embed.service` 的 `MemoryMax=2560M` 与此处同值：
# 二者是同一约束的两个落点（内核 cgroup 上限 vs 服务自述）。改一处必须改另一处。
# 目标机实为 11GiB，该值须在 [TBD-T4]/[TBD-T16] 实测后重定。
IB_EMBED_MEMORY_LIMIT_MB=2560

# === 本文件**不含**的键（刻意）================================================
# * 任何令牌 / 密钥：本服务不需要凭据（加了就是净增凭据面）。
# * `IB_EMBED_BACKEND`：属**客户端**（ib-web）的装配开关，不在服务端。
# * `IB_EMBED_URL` / `IB_EMBED_TIMEOUT_*` / `IB_EMBED_RETRY_*`：属**客户端**
#   冷/热双路径的两个实例。服务端**不区分冷热**（IFC-IB-273 单一落点）——
#   为服务端补一套超时/重试键会把该纪律**双落点化**，是最需要避免的漂移。
