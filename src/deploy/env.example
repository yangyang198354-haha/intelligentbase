# ---------------------------------------------------------------------------
# @module MOD-IB-25
# @implements IFC-IB-262 EnvironmentFile 模板（**纯占位符，无任何真实值**）
# @author software-developer
#
# 安装（目标机，需 root）：
#   install -m 0600 -o ib-web -g ib-web env.example /etc/intelligentbase/ib-web.env
#   # 按后端/worker 的实际用户分别复制并调整属主
#
# 为什么必须是 0600 且属主为运行用户：
#   本文件**是**凭据的真源（值经环境变量注入进程）。0644 意味着同机任何用户都能读到
#   LLM API Key 与服务账号令牌 —— 而「同机其他用户」在多服务共存的目标机上是常态。
#   检查清单第 1 项会显式验证权限位。
#
# 真实值一律**不写入本仓库**：本文件被 git 跟踪，任何真实值都会永久留在历史里
# （即便后续删除，`git log -p` 仍能取回）。填值只在部署机的 0600 文件里做。
#
# 版本约束：本文件的键名与 module_design §5 逐个对应，**不得新增或改名**。
# 新增一个 IB_* 键必须先回到设计文档评审 —— 否则「配置键名」这个对外契约会悄悄漂移。
# ---------------------------------------------------------------------------

# === 模式与配置来源 ==========================================================
# 生产必须为 0。`1` 会把全部后端切到内存替身（不连 Qdrant / 不调 LLM / 无 OCR）——
# 只用于本机自测。误设为 1 的服务**看起来完全正常**，但知识库永远是空的。
IB_OFFLINE_MODE=0

# 配置来源：`file`（生产）或 `dict`（仅离线自测注入）。
IB_CONFIG_SOURCE=file
IB_CONFIG_FILE=/etc/intelligentbase/config.json

# === 日志 ====================================================================
# 生产建议 INFO（debug 会显著增加日志量，且树莓派 SD 卡寿命有限）。
IB_LOG_LEVEL=INFO

# === 载体（Django / WSGI）====================================================
# Django 要求 SECRET_KEY 非空。本服务不使用签名/会话，但**仍需注入**（禁止硬编码）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
IB_DJANGO_SECRET_KEY=<REPLACE_ME_generated_random_secret>

# 必须是 nginx 实际使用的 Host（空列表在 DEBUG=False 下会让**所有**请求 400）。
IB_ALLOWED_HOSTS=<REPLACE_ME_host>

# === 向量库（Qdrant）=========================================================
IB_VECTORSTORE_BACKEND=qdrant
IB_QDRANT_URL=http://127.0.0.1:6333

# === Embedding（ib-embed 常驻服务）==========================================
IB_EMBED_BACKEND=http
IB_EMBED_URL=http://127.0.0.1:8100
IB_EMBED_MODEL_ID=bge-m3
IB_EMBED_DIM=1024

# === LLM（DeepSeek）==========================================================
# 云端调用：**数据会离开本机**（问题文本 + 检索到的片段）。
# 这一事实经 EgressDescriptor 输出到启动日志与 GET /healthz/deps（NFR-08）。
IB_LLM_BACKEND=openai_compatible
IB_LLM_BASE_URL=https://api.deepseek.com/v1
IB_LLM_MODEL=deepseek-chat
IB_LLM_API_KEY=<REPLACE_ME_llm_api_key>

# === 台账 ====================================================================
IB_LEDGER_BACKEND=sqlite
IB_LEDGER_PATH=/var/lib/intelligentbase/ledger/ledger.sqlite3

# === 原文件存储（OQ-IB-01：已确认开启）======================================
IB_BLOB_STORE_ENABLED=1
IB_BLOB_ROOT=/var/lib/intelligentbase/blobs

# === 解析能力开关 ============================================================
IB_OCR_ENABLED=1
IB_RENDER_ENABLED=1

# === 会话 ====================================================================
IB_SESSION_BACKEND=memory

# === 鉴权（NFR-09 / AC-IB-11-05）============================================
# **生产必须设置**。未设置 → 组合根在启动期直接抛 StartupError，进程起不来。
# 指向的模块必须提供 `POLICY`（AuthzPolicy 实现）与 `resolve_principal(token)`。
# 示例：IB_AUTHZ_POLICY_MODULE=myorg.freeark_authz
IB_AUTHZ_POLICY_MODULE=<REPLACE_ME_module_path>

# 服务账号令牌（由接入方的策略模块按自己的账号体系校验；此处仅登记键名）
IB_SERVICE_TOKEN=<REPLACE_ME_service_token>

# === 离线自测专用（生产**不要**设置）=======================================
# 仅在 IB_OFFLINE_MODE=1 时使用；生产留空即不生效。
IB_OFFLINE_TOKEN=<REPLACE_ME_only_for_offline_selfcheck>

# 语义路由（L1）示例句目录（可选）。缺失则 L1 自动跳过（fail-open，不影响 L0/L2/L3）。
IB_EXEMPLARS_DIR=/etc/intelligentbase/exemplars
